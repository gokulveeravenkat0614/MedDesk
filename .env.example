# CareGuard Clinic Management — Environment Configuration Template
# Copy to .env and configure strong secrets in production

# Server Port
PORT=5000
NODE_ENV=development

# JWT Authentication Secrets (Must be 32+ characters in production)
JWT_SECRET=careguard_jwt_super_secure_clinical_token_secret_2026_key
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=careguard_refresh_token_vault_secret_2026_secure
JWT_REFRESH_EXPIRES_IN=7d

# Session Security
SESSION_SECRET=careguard_session_cryptographic_signing_key_98472

# Security Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# Synthetic Data Sandbox Notice
SYNTHETIC_DATA_SANDBOX=true
